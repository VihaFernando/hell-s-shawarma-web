# Instagram Graph API (Business Discovery) — used by netlify/functions/instagram.js
# and netlify/functions/instagram-refresh-token*.js

# The Instagram Business Account ID whose linked Facebook app/token performs the
# Business Discovery lookup (does NOT have to be the client's own account).
IG_BUSINESS_ACCOUNT_ID=

# Long-lived Instagram/Facebook Graph API access token (~60 day expiry).
# Auto-refreshed monthly by the scheduled function and stored in Netlify Blobs;
# this env var is only the initial/fallback value.
IG_LONG_LIVED_TOKEN=

# Facebook App ID + Secret, used to exchange/refresh the long-lived token.
IG_APP_ID=
IG_APP_SECRET=

# The client's public Instagram username to fetch posts for via Business Discovery.
CLIENT_IG_USERNAME=

# Netlify Blobs credentials, used to explicitly configure the Blobs client
# (works around Netlify not always auto-injecting Blobs context for Scheduled
# Functions). BLOBS_SITE_ID is the site's Project ID (Project configuration
# > General). BLOBS_TOKEN is a Netlify Personal Access Token (User settings >
# Applications > Personal access tokens) with access to this site.
BLOBS_SITE_ID=
BLOBS_TOKEN=

# Google Places API (New) — used by netlify/functions/reviews.js

# API key with the Places API (New) enabled.
GOOGLE_PLACES_API_KEY=

# The business's Google Place ID (not secret — also used to build the public
# "view all reviews" link).
GOOGLE_PLACE_ID=

# Your site's origin (e.g. https://hellsshawarma.lk or a
# custom domain), used to reject requests to /api/reviews whose Origin/Referer
# doesn't match — stops the endpoint being scraped/hotlinked from other sites.
ALLOWED_ORIGIN=

# Supabase — blog content + admin auth.
# URL and publishable key are public (VITE_ prefix ships them to the browser;
# Row Level Security protects the data). The secret key bypasses RLS: server
# only (Netlify Functions + build-time prerender), never prefix it with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Netlify Build Hook URL (Site configuration > Build & deploy > Build hooks).
# Called by the blog publish function so new/updated posts get prerendered.
NETLIFY_BUILD_HOOK_URL=

# Cloudinary — blog image uploads (signed by a Netlify Function) and delivery.
# Blog-only account; the Instagram reels use their own in InfluencerReels.tsx.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Team invite emails via Resend (optional; free tier 3,000/month). Without these,
# the admin shows the invite message + temporary password to copy and share.
# BLOG_EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
BLOG_EMAIL_FROM="Hell's Shawarma <team@hellsshawarma.lk>"
